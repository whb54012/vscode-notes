检查账户权限以及系统版本信息
id && whoami          # 我是谁、在哪些组里
uname -a              # 内核版本
cat /etc/os-release   # 发行版
hostname              # 主机名
检查suid和sgid
find / -perm -4000 -type f 2>/dev/null    # SUID
find / -perm -2000 -type f 2>/dev/null    # SGID
查看sudo权限
sudo -l
查看内核
uname -r
检查定时任务
cat /etc/crontab
ls -la /etc/cron.d/ /etc/cron.hourly/ /etc/cron.daily/
ls -la /var/spool/cron/crontabs/ 2>/dev/null
检查敏感文件
cat ~/.bash_history              # 管理员敲过的命令，常带明文密码
cat /root/.bash_history 2>/dev/null
find / -name "*.key" -o -name "id_rsa*" 2>/dev/null
ls -l /etc/passwd              # 可写？→ 加 UID=0 用户
ls -l /etc/shadow              # 可读？→ 拿 hash 爆破
ls -l /etc/sudoers             # 可写？→ 加自己进 sudoers
ls -l /root/                   # 可进？→ 直接读
ls -l /root/.ssh/              # 有私钥？→ 登别的地方